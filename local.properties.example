# Copy this file to local.properties and fill in your local values.

# ANDROID SDK
sdk.dir=/path/to/Android/sdk

# Google Maps API Key
MAPS_API_KEY=YOUR_API_KEY_HERE

# OpenSky OAuth2 (new accounts)
OPENSKY_CLIENT_ID=your_client_id
OPENSKY_CLIENT_SECRET=your_client_secret

# Optional: OpenSky Basic Auth (legacy accounts)
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

## This file should be copied to local.properties and updated with your values
## local.properties is git-ignored and will not be committed

# Android SDK location
sdk.dir=/path/to/your/android/sdk

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/
# Enable "Maps SDK for Android" API
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

